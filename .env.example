# ==============================================================================
# EdgeGo Voice - Variáveis de Ambiente de Exemplo
# ==============================================================================

PORT=5050
HOST=0.0.0.0
API_KEY=minha-chave-secreta
REQUIRE_AUTH=true

# Cache LRU em Memória
CACHE_ENABLED=true
CACHE_MAX_MB=50
CACHE_TTL_HOURS=24

# Padrões de Áudio
DEFAULT_VOICE=pt-BR-ThalitaMultilingualNeural
DEFAULT_FORMAT=opus
DEFAULT_SPEED=1.0
DEFAULT_LANGUAGE=pt-BR
REMOVE_FILTER=true

# Proxy Opcional
PROXY=
